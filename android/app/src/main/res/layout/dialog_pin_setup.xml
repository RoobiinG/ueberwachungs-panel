<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvPinSetupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Neuen PIN festlegen"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPinSetupDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:letterSpacing="0.3"
        android:text="○○○○"
        android:textColor="@color/accent_blue"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/tvPinSetupError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/accent_red"
        android:textSize="13sp" />

    <!-- PIN-Pad -->
    <LinearLayout android:layout_width="220dp" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <Button android:id="@+id/sBtn1" android:layout_width="0dp" android:layout_height="50dp"
                android:layout_weight="1" android:layout_margin="3dp" android:text="1"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <Button android:id="@+id/sBtn2" android:layout_width="0dp" android:layout_height="50dp"
                android:layout_weight="1" android:layout_margin="3dp" android:text="2"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <Button android:id="@+id/sBtn3" android:layout_width="0dp" android:layout_height="50dp"
                android:layout_weight="1" android:layout_margin="3dp" android:text="3"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <Button android:id="@+id/sBtn4" android:layout_width="0dp" android:layout_height="50dp"
                android:layout_weight="1" android:layout_margin="3dp" android:text="4"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <Button android:id="@+id/sBtn5" android:layout_width="0dp" android:layout_height="50dp"
                android:layout_weight="1" android:layout_margin="3dp" android:text="5"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <Button android:id="@+id/sBtn6" android:layout_width="0dp" android:layout_height="50dp"
                android:layout_weight="1" android:layout_margin="3dp" android:text="6"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <Button android:id="@+id/sBtn7" android:layout_width="0dp" android:layout_height="50dp"
                android:layout_weight="1" android:layout_margin="3dp" android:text="7"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <Button android:id="@+id/sBtn8" android:layout_width="0dp" android:layout_height="50dp"
                android:layout_weight="1" android:layout_margin="3dp" android:text="8"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <Button android:id="@+id/sBtn9" android:layout_width="0dp" android:layout_height="50dp"
                android:layout_weight="1" android:layout_margin="3dp" android:text="9"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_margin="3dp"/>
            <Button android:id="@+id/sBtn0" android:layout_width="0dp" android:layout_height="50dp"
                android:layout_weight="1" android:layout_margin="3dp" android:text="0"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <ImageButton android:id="@+id/sBtnDel"
                android:layout_width="0dp" android:layout_height="50dp"
                android:layout_weight="1" android:layout_margin="3dp"
                android:src="@drawable/ic_backspace"
                android:background="@drawable/bg_spinner"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
