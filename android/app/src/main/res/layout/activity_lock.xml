<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Lock-Icon -->
    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_lock" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Überwachungs-Panel"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- PIN-Dots -->
    <TextView
        android:id="@+id/tvPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:letterSpacing="0.3"
        android:text="○○○○"
        android:textColor="@color/accent_blue"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColor="@color/accent_red"
        android:textSize="13sp" />

    <!-- PIN-Pad 3x4 -->
    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_margin="4dp" android:text="1"
                android:textSize="20sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_margin="4dp" android:text="2"
                android:textSize="20sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_margin="4dp" android:text="3"
                android:textSize="20sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_margin="4dp" android:text="4"
                android:textSize="20sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_margin="4dp" android:text="5"
                android:textSize="20sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_margin="4dp" android:text="6"
                android:textSize="20sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_margin="4dp" android:text="7"
                android:textSize="20sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_margin="4dp" android:text="8"
                android:textSize="20sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_margin="4dp" android:text="9"
                android:textSize="20sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <!-- Biometrie-Taste (linke Seite) -->
            <ImageButton android:id="@+id/btnBiometric"
                android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_margin="4dp"
                android:src="@drawable/ic_fingerprint"
                android:background="@drawable/bg_spinner"
                android:visibility="gone" />
            <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_margin="4dp" android:text="0"
                android:textSize="20sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <ImageButton android:id="@+id/btnDel"
                android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_margin="4dp"
                android:src="@drawable/ic_backspace"
                android:background="@drawable/bg_spinner" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
